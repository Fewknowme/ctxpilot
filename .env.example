# Copy this file to `.env` in the root of the project where you run ctxpilot.
# Example:
#   /path/to/your-project/.env
#
# Optional global location:
#   ~/.ctxpilot/.env
# The project-level `.env` wins over the global file.

# Provider: anthropic | openai | local
CK_PROVIDER=anthropic

# Anthropic (BYO API key)
CK_API_KEY=your_anthropic_key_here

# OpenAI (BYO API key)
# CK_PROVIDER=openai
# CK_OPENAI_API_KEY=your_openai_key_here

# Free (local) — requires Ollama (https://ollama.com)
# CK_PROVIDER=local
# CK_MODEL=gemma3:4b
# CK_LOCAL_URL=http://localhost:11434

# Optional model override (any provider)
# CK_MODEL=claude-sonnet-4-20250514
